TRUENAS_HOST=192.168.1.29:444
TRUENAS_API_KEY=your-api-key-here
TRUENAS_INSECURE=true

# Bearer token clients must send as "Authorization: Bearer <token>" (e.g. `openssl rand -hex 32`)
MCP_AUTH_TOKEN=change-me

# Optional
# PORT=3000
# DOCKER_SOCKET=/var/run/docker.sock   # container tools are disabled if the socket is missing
# DOCKER_WRITE_TOOLS=false             # "true" adds container_start/stop/restart and image_pull
